---
/**
 * Розрахунковий приклад: дано, формула, покроковий розв'язок, відповідь та інтерпретація.
 * Іменовані слоти — так само, як `<Fragment slot="…">` у CaseStudy. Формула і відповідь — через
 * data-typography="off" на самому слоті в MDX (нормалізація тексту не повинна чіпати математику).
 */
interface Props {
  title: string;
  /** Код формули з бази курсу, наприклад EOQ-01. */
  code: string;
  source?: string;
  id?: string;
}

const { title, code, source, id } = Astro.props;
const headingId = id ?? `example-${code.toLowerCase().replace(/[^a-z0-9]+/gu, '-').replace(/^-|-$/g, '')}`;
---

<article class="worked-example" aria-labelledby={headingId} data-worked-example={code}>
  <div class="we-head">
    <h3 id={headingId}>Приклад. {title}</h3>
    <code class="we-code">{code}</code>
  </div>
  {source && <p class="we-source small faint">{source}</p>}

  <div class="we-part">
    <h4 class="we-h">Дано</h4>
    <div class="we-body"><slot name="given" /></div>
  </div>

  <div class="we-part">
    <h4 class="we-h">Формула</h4>
    <div class="we-body we-formula num"><slot name="formula" /></div>
  </div>

  <div class="we-part">
    <h4 class="we-h">Розв’язання</h4>
    <ol class="we-steps"><slot name="steps" /></ol>
  </div>

  <div class="we-part we-answer">
    <h4 class="we-h">Відповідь</h4>
    <div class="we-body num"><slot name="answer" /></div>
  </div>

  <div class="we-part">
    <h4 class="we-h">Інтерпретація</h4>
    <div class="we-body"><slot name="interpretation" /></div>
  </div>
</article>

<style>
  .worked-example {
    border: 1px solid var(--line);
    border-radius: var(--r-2);
    padding: var(--s-5);
    background: var(--surface);
    box-shadow: var(--shadow-1);
    font-size: var(--text-md);
    line-height: 1.55;
  }
  .we-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--s-3);
    flex-wrap: wrap;
  }
  .we-head h3 {
    margin: 0;
    font-size: var(--text-lg);
  }
  .we-code {
    font-size: var(--text-xs);
    color: var(--ink-3);
    background: var(--bg-sunken);
    padding: 0.15em 0.5em;
    border-radius: 4px;
    white-space: nowrap;
  }
  .we-source {
    margin-top: var(--s-1);
  }
  .we-part {
    margin-top: var(--s-4);
    padding-top: var(--s-4);
    border-top: 1px solid var(--line);
  }
  .we-h {
    font-size: var(--text-xs);
    font-weight: 650;
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--ink-3);
    margin: 0 0 var(--s-2);
  }
  .we-formula {
    font-weight: 600;
    overflow-x: auto;
  }
  .we-steps {
    padding-left: 1.4rem;
    list-style: decimal;
  }
  .we-answer .we-body {
    font-weight: 650;
    color: var(--ink);
  }
</style>

<style is:global>
  .worked-example .we-body > * + * {
    margin-top: var(--s-3);
  }
  .worked-example .we-steps > li + li {
    margin-top: var(--s-2);
  }
</style>
